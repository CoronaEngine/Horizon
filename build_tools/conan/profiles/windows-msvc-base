{% set compiler, version, _ = detect_api.detect_msvc_compiler() %}
{% set compiler_version = detect_api.default_compiler_version(compiler, version) %}
{% set runtime, _ = detect_api.default_msvc_runtime(compiler) %}
{% set ide_version = detect_api.default_msvc_ide_version(version) %}
[settings]
os=Windows
arch=x86_64
compiler={{ compiler }}
compiler.version={{ compiler_version }}
compiler.cppstd=20
compiler.runtime={{ runtime }}

[conf]
tools.cmake.cmaketoolchain:generator=Ninja Multi-Config
tools.microsoft.msbuild:vs_version={{ ide_version }}
