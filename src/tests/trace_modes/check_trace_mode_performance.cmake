string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(cache "${ROOT}/${id}")
file(MAKE_DIRECTORY "${cache}")
set(ENV{REBLUR_GPU_PROFILE} "${cache}/timestamps.csv")
set(ENV{REBLUR_GPU_PROFILE_MODE} "dispatch")
unset(ENV{REBLUR_GPU_PROFILE_DIAGNOSTICS})
execute_process(COMMAND "${TEST}" performance "${cache}" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180)
if("${result}" STREQUAL "77")
    file(REMOVE_RECURSE "${cache}")
    message("TRACE_MODE_UNAVAILABLE comparison requires both modes")
    return()
endif()
message("${output}\n${error}")
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Performance comparison exited ${result}, artifacts in ${cache}")
endif()
file(REMOVE_RECURSE "${cache}")
