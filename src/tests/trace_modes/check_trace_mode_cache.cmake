string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(cache "${ROOT}/${MODE}-${id}")
file(MAKE_DIRECTORY "${cache}")
foreach(phase cold hot)
    # Separate processes ensure the hot pass reads the artifacts from disk.
    execute_process(COMMAND "${TEST}" "${MODE}" "${cache}" RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
    if("${result}" STREQUAL "77")
        file(REMOVE_RECURSE "${cache}")
        message("TRACE_MODE_UNAVAILABLE ${MODE}")
        return()
    endif()
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${phase} ${MODE} result=${result}\n${output}\n${error}")
    endif()
    set(log "${output}\n${error}")
    message("${log}")
    if(phase STREQUAL cold)
        set(event miss)
        file(GLOB modules RELATIVE "${cache}/slang_cache" "${cache}/slang_cache/*.spv")
        if(NOT modules)
            message(FATAL_ERROR "Cold run produced no SPIR-V in ${cache}")
        endif()
        execute_process(COMMAND "${PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/check_trace_mode_spirv.py" "${MODE}" "${cache}"
            COMMAND_ERROR_IS_FATAL ANY)
    else()
        set(event hit)
        if(log MATCHES "shader SPIR-V cache miss:")
            message(FATAL_ERROR "Hot run recompiled a module\n${log}")
        endif()
    endif()
    foreach(module IN LISTS modules)
        string(FIND "${log}" "shader SPIR-V cache ${event}: ${module}" found)
        if(found LESS 0)
            message(FATAL_ERROR "Missing ${phase} ${event} for ${module}\n${log}")
        endif()
    endforeach()
    message(STATUS "${phase} ${MODE} validated modules ${modules}")
endforeach()
file(REMOVE_RECURSE "${cache}")
