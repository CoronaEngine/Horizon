set(incompatible "RayTracingPipeline incompatible with Vulkan shader 'trace-local-rejection': callable 'trace-local-restriction': ")
if(REASON STREQUAL "workgroup")
    set(diagnostic "${incompatible}synchronize_block")
elseif(REASON STREQUAL "warp")
    set(diagnostic "${incompatible}warp operation")
elseif(REASON STREQUAL "unknown")
    set(diagnostic "${incompatible}custom header 'trace-mode-unknown[.]slang'")
elseif(REASON STREQUAL "limit-axis")
    set(diagnostic "Ray dispatch dimension [0-9]+ exceeds axis [0-2] limit [0-9]+")
elseif(REASON STREQUAL "limit-product")
    set(diagnostic "Ray dispatch [0-9]+ x [0-9]+ x [0-9]+ exceeds maxRayDispatchInvocationCount [0-9]+")
elseif(REASON STREQUAL "unavailable-query")
    set(diagnostic "RayQuery unavailable for Vulkan shader 'trace-local-rejection'")
elseif(REASON STREQUAL "unavailable-pipeline")
    set(diagnostic "RayTracingPipeline unavailable for Vulkan shader 'trace-local-rejection'")
else()
    message(FATAL_ERROR "Unexpected rejection case ${REASON}")
endif()

# A common output pipe preserves the order of the startup logs, banner and diagnostic.
execute_process(COMMAND "${TEST}" "reject-${REASON}" RESULT_VARIABLE result
    OUTPUT_VARIABLE log ERROR_VARIABLE log TIMEOUT 60)
if("${result}" STREQUAL "77")
    message("${log}")
    message("TRACE_MODE_UNAVAILABLE ${REASON} does not apply on this device")
    return()
endif()

string(REPLACE "\r\n" "\n" log "${log}")
string(PREPEND log "\n")
set(banner "\nattempting rejection ${REASON}\n")
string(FIND "${log}" "${banner}" attempt)
if(attempt GREATER_EQUAL 0)
    string(LENGTH "${banner}" banner_length)
    math(EXPR start "${attempt} + ${banner_length}")
    string(SUBSTRING "${log}" ${start} -1 after_banner)
endif()
# Accept the raw diagnostic or an error-logger prefix on the same line.
set(line "(^|\n)([^\n]*\\[ERROR\\][^\n]*\\] )?${diagnostic}(\n|$)")
# OC_ERROR exits nonzero in Release. Its flushed diagnostic precedes the assertion abort in Debug.
if((NOT "${result}" MATCHES "^-?[1-9][0-9]*$" AND NOT "${result}" STREQUAL "Subprocess aborted") OR
   attempt LESS 0 OR NOT after_banner MATCHES "${line}")
    message(FATAL_ERROR "${REASON} expected diagnostic ${diagnostic}, exit=${result}\n${log}")
endif()
message(STATUS "Observed ${REASON} rejection, exit=${result}\n${log}")
